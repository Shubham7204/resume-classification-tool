# Copy to .env.local for local development. On Vercel, add these under
# Project Settings → Environment Variables (Production + Preview).

# Neon Postgres (`neon env pull` writes these)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Name of the Neon branch. Reset-all is refused on "production".
NEON_BRANCH=production

# Neon Object Storage (S3-compatible) for resume and JD PDFs
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# TypeSafe Jev: scores every resume against the role's rubric (required)
TYPESAFE_API_KEY=

# LLM providers for reading resumes, drafting rubrics and talent search.
# Groq is tried first, Ollama Cloud is the fallback; at least one is needed.
GROQ_API_KEY=
OLLAMA_API_KEY=
